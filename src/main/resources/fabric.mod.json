{
	"schemaVersion": 1,
	"id": "craftguessr",
	"version": "${version}",
	"name": "CraftGuessr",
	"description": "Multiplayer real-world GeoGuessr for Minecraft: AI-picked scenic spots, a native surface map, immersive observation rounds and a double reveal with 2D map lines and 3D hologram beams.",
	"authors": [
		"CraftGuessr"
	],
	"contact": {
		"homepage": "https://github.com/turboegg1145/craftguessr",
		"sources": "https://github.com/turboegg1145/craftguessr"
	},
	"license": "MIT",
	"icon": "assets/craftguessr/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.craftguessr.CraftGuessr"
		],
		"client": [
			"com.craftguessr.client.CraftGuessrClient"
		]
	},
	"mixins": [
		"craftguessr.mixins.json",
		{
			"config": "craftguessr.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
